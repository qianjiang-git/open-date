# Local development only. Copy to .env, fill real values, and never commit .env.
# The deployed service gets DATABASE_URL from Render; do not put a production DSN here.

# Local Postgres (optional). Without it the app uses server/vexo.db (SQLite).
DATABASE_URL=postgresql://vexo:vexo@localhost:5432/vexo

# real | single_laptop | simulated
VEXO_DEMO_MODE=simulated

# deterministic | claude
SCORER_PROVIDER=deterministic

# Comma-separated authorised band numbers for the demo roster, e.g. 12,36
# VEXO_ROSTER=12,36

# Only for a separate frontend origin (for example a Replit preview). Same-origin
# production needs nothing here. Exact origins, no wildcard.
# CORS_ORIGINS=http://localhost:5173,https://<preview>.replit.dev

# Only needed when SCORER_PROVIDER=claude. Server-side only.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
